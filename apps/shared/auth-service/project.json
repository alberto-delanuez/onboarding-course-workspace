{
  "name": "@onboarding-course/auth-service",
  "sourceRoot": "apps/shared/auth-service/src",
  "projectType": "application",
  "targets": {
    "pre-commit": {},
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/shared/auth-service",
        "command": "tsc -p tsconfig.json"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/shared/auth-service",
        "command": "node dist/src/main.js"
      },
      "dependsOn": ["build"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/shared/auth-service",
        "command": "node --loader ts-node/esm src/main.ts"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/shared/auth-service",
        "command": "node dist/src/main.js"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo \"no tests yet\""
      }
    }
  },
  "tags": ["scope:shared", "type:service"]
}
