{
  "name": "@onboarding-course/formal-blue",
  "targets": {
    "pre-commit": {},
    "generate-version": {
      "executor": "nx:run-commands",
      "outputs": ["{options.outputPath}/version.json"],
      "options": {
        "command": "tools/scripts/generate-version.sh formal-blue dist/apps/customer/formal-blue",
        "outputPath": "dist/apps/customer/formal-blue"
      }
    },
    "analyze": {
      "executor": "nx:run-commands",
      "outputs": ["{options.outputPath}"],
      "options": {
        "command": "nx build formal-blue --configuration=production --skip-nx-cache",
        "outputPath": "dist/apps/customer/formal-blue",
        "env": {
          "ANALYZE": "true"
        }
      }
    },
    "docker:build":{
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx build formal-blue --configuration=production --skip-nx-cache",
          "docker build -f apps/customer/formal-blue/Dockerfile -t formal-blue:$(cat dist/apps/customer/formal-blue/version.json | jq -r .version) ."
        ],
        "parallel": false
      }
    },
    "docker:run":{
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "docker run -p 4200:80 formal-blue:$(cat dist/apps/customer/formal-blue/version.json | jq -r .version)"
        ],
        "parallel": false
      }
    },
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "dependsOn": ["generate-version"],
      "options": {
        "outputPath": "dist/apps/customer/formal-blue"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    }
  }
}
