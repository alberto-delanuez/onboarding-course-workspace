{
  "name": "@onboarding-course/mad-purple",
  "targets": {
    "pre-commit": {},
    "generate-version": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tools/scripts/generate-version.sh mad-purple dist/apps/customer/mad-purple"
      }
    },
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "dependsOn": ["generate-version"],
      "options": {
        "outputPath": "dist/apps/customer/mad-purple"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    }
  }
}
