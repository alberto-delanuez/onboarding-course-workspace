{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": ["node", "vite/client"],
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo"
  },
  "exclude": [
    "out-tsc",
    "dist",
    "**/*.spec.ts",
    "**/*.test.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "eslint.config.mjs"
  ],
  "rootDir": ["src"],
  "include": ["src/**/*.ts"]
}
