{
    "extends": "../../../../tsconfig.base.json",
    "compilerOptions": {
        "baseUrl": ".",
        "rootDir": "src",
        "outDir": "dist",
        "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
        "emitDeclarationOnly": true,
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "forceConsistentCasingInFileNames": true,
        "types": ["node", "vite/client"]
    },
    "include": ["src/**/*.ts"],
    "references": [
        {
            "path": "../di/tsconfig.lib.json"
        },
        {
            "path": "../../auth/application/tsconfig.lib.json"
        },
        {
            "path": "../../auth/infrastructure/tsconfig.lib.json"
        },
        {
            "path": "../../profile/application/tsconfig.lib.json"
        },
        {
            "path": "../../profile/infrastructure/tsconfig.lib.json"
        }
    ],
    "exclude": [
        "vite.config.ts",
        "vite.config.mts",
        "vitest.config.ts",
        "vitest.config.mts",
        "src/**/*.test.ts",
        "src/**/*.spec.ts",
        "src/**/*.test.tsx",
        "src/**/*.spec.tsx",
        "src/**/*.test.js",
        "src/**/*.spec.js",
        "src/**/*.test.jsx",
        "src/**/*.spec.jsx"
    ]
}
