{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["development"],
    "baseUrl": ".",
    "paths": {
      "@onboarding-course/customer-themes-base": [
        "libs/customer/themes/base/src/index.ts"
      ],
      "@onboarding-course/customer-themes-blue": [
        "libs/customer/themes/blue/src/index.ts"
      ],
      "@onboarding-course/customer-themes-green": [
        "libs/customer/themes/green/src/index.ts"
      ]
    }
  }
}
